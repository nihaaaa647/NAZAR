# Profiler and ingestion read exported environment variables or --root.
# This template is not loaded automatically; no credentials are needed yet.
NAZAR_DATA_ROOT=mplads_india
NAZAR_CANONICAL_ROOT=data/canonical
# CSV storage is selected for now; no database configuration is needed.
# Backend auth (demo). Defaults in backend/main.py work out of the box; override
# the fixed per-persona accounts and always set a real secret for a shared deploy.
# NAZAR_AUTH_SECRET=change-me
# NAZAR_USERS=mp_office:mp.office:pw,district_authority:district.authority:pw,state_nodal:state.nodal:pw,ministry:ministry:pw
# NAZAR_TOKEN_TTL=28800
# Reviewer decisions (Confirm/Dismiss). Unset = local SQLite file at
# NAZAR_DB_PATH (the default, fine for local dev). Set to a Postgres
# connection string (e.g. a free Neon project) for any deploy without a
# persistent disk — see README's Deploy section. NEVER put a real value here;
# this file is committed. Set it directly in your host's env var store.
# NAZAR_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
